{
    "name": "ng-ssr-caching-react-example",
    "private": true,
    "type": "module",
    "description": "React SSR on Express, with ng-ssr-caching in front of the render",
    "scripts": {
        "start": "node server.js",
        "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist/server"
    },
    "dependencies": {
        "express": "^5.1.0",
        "ng-ssr-caching": "^22.2.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^4.3.4",
        "vite": "^6.0.0"
    },
    "stackblitz": {
        "startCommand": "npm start"
    },
    "allowScripts": {
        "esbuild@0.25.12": true
    }
}
